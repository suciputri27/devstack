#!/usr/bin/env python3
import argparse
import subprocess
import sys
from pathlib import Path


def git(*args):
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    return result.returncode, result.stdout.strip(), result.stderr.strip()


def main():
    parser = argparse.ArgumentParser(description="Prove an agent's claims before it reports done")
    parser.add_argument("--commit", nargs="*", metavar="SHA", help="commits that must exist (no value = HEAD)")
    parser.add_argument("--file", nargs="*", default=[], metavar="PATH", help="files that must exist and be changed or committed")
    parser.add_argument("--run", nargs="*", default=[], metavar="CMD", help="commands that must pass, e.g. \"php artisan test\"")
    parser.add_argument("--since", metavar="BASE", help="list commits since BASE")
    args = parser.parse_args()

    failures = []
    code, top, _ = git("rev-parse", "--show-toplevel")
    if code != 0:
        print("devstack-verify: NOT VERIFIED, bukan repo git")
        return 1
    _, branch, _ = git("rev-parse", "--abbrev-ref", "HEAD")
    _, head, _ = git("log", "-1", "--format=%h %s (%cr)")
    _, status, _ = git("status", "--porcelain")
    changed = [line for line in status.splitlines() if line]
    print(f"repo     : {top}")
    print(f"branch   : {branch}")
    print(f"HEAD     : {head or 'belum ada commit'}")
    print(f"worktree : {'bersih' if not changed else f'{len(changed)} file belum di-commit'}")
    for line in changed[:10]:
        print(f"           {line}")

    if args.commit is not None:
        for sha in args.commit or ["HEAD"]:
            code, out, _ = git("show", "--stat", "--format=%h %s (%an, %cr)", sha)
            if code != 0:
                failures.append(f"commit {sha} tidak ada")
                print(f"commit   : {sha} TIDAK ADA")
            else:
                lines = out.splitlines()
                print(f"commit   : {lines[0]}")
                for line in lines[1:8]:
                    if line.strip():
                        print(f"           {line.strip()}")

    if args.since:
        code, out, _ = git("log", "--oneline", f"{args.since}..HEAD")
        print(f"sejak {args.since}: {len(out.splitlines()) if out else 0} commit")
        for line in out.splitlines()[:15]:
            print(f"           {line}")

    for path in args.file:
        p = Path(top) / path if not Path(path).is_absolute() else Path(path)
        if not p.exists():
            failures.append(f"file {path} tidak ada")
            print(f"file     : {path} TIDAK ADA")
            continue
        rel = str(p.resolve().relative_to(Path(top).resolve())) if str(p.resolve()).startswith(str(Path(top).resolve())) else path
        _, tracked, _ = git("ls-files", "--error-unmatch", rel)
        _, last, _ = git("log", "-1", "--format=%h %cr", "--", rel)
        state = "belum di-commit" if any(rel in line for line in changed) else (f"commit terakhir {last}" if last else "tidak ter-track")
        print(f"file     : {rel} ({p.stat().st_size} byte, {state})")

    for cmd in args.run:
        print(f"run      : {cmd}")
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        output = (result.stdout + result.stderr).strip().splitlines()
        for line in output[-15:]:
            print(f"           {line}")
        print(f"           exit {result.returncode}")
        if result.returncode != 0:
            failures.append(f"'{cmd}' gagal (exit {result.returncode})")

    if failures:
        print("devstack-verify: NOT VERIFIED")
        for f in failures:
            print(f"  - {f}")
        return 1
    print("devstack-verify: VERIFIED")
    return 0


if __name__ == "__main__":
    sys.exit(main())
