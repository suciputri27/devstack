# Versi komponen yang dipin. Uji di server staging sebelum menaikkan versi.
# Nilai di .env dengan nama yang sama akan menimpa nilai di sini.
NINEROUTER_IMAGE=decolua/9router
NINEROUTER_IMAGE_TAG=0.5.112
SEARXNG_IMAGE=searxng/searxng
SEARXNG_IMAGE_TAG=latest
NODE_MAJOR=22
# Tambahkan @versi untuk mengunci OMP, contoh: @oh-my-pi/pi-coding-agent@18.0.3
OMP_PACKAGE=@oh-my-pi/pi-coding-agent
NPM_GLOBALS="intelephense typescript typescript-language-server vscode-langservers-extracted uipro-cli"
# Tool otak devstack (kosong = versi terbaru saat install)
SEMGREP_VERSION=
PLAYWRIGHT_PY_VERSION=
