# ============================================================
# devstack: semua nilai pribadi ada di file ini.
# Contoh dan dokumentasi semua nilai. Install pertama membuat /etc/devstack/devstack.env lewat wizard.
# Ubah nilai kapan saja dengan: sudo devstack config
# ============================================================

# ---------- Akun kerja di server ----------
DEVSTACK_USER=dev
# Wajib diisi jika user belum ada. Dipakai untuk sudo (login SSH tetap hanya pakai key).
DEVSTACK_USER_PASSWORD=
# Isi public key laptop Anda (isi ~/.ssh/id_ed25519.pub), satu baris, dalam tanda kutip.
DEVSTACK_SSH_PUBKEY=""
DEVSTACK_HOSTNAME=devbox
DEVSTACK_TIMEZONE=Asia/Jakarta

# ---------- Jaringan ----------
# IP server ini di jaringan kantor (cek di server: ip -4 addr). Semua layanan di-bind ke IP ini.
SERVER_IP=192.168.1.50
# Subnet yang boleh mengakses SSH, 9Router, dan SearXNG. Pisahkan dengan spasi.
#   - Subnet LAN kantor, contoh 192.168.1.0/24
#   - Subnet klien VPN kantor jika berbeda dari LAN, contoh 10.10.0.0/24
# Cara cek subnet VPN: dari rumah, sambungkan VPN, SSH ke server, lalu jalankan: echo $SSH_CLIENT
# Alamat pertama yang muncul adalah alamat Anda menurut server.
ALLOWED_SUBNETS="192.168.1.0/24"
# Port yang harus tetap terbuka untuk semua alamat (biasanya kosong untuk server kantor).
PUBLIC_PORTS=
# true  = SSH hanya dari ALLOWED_SUBNETS (disarankan).
# false = SSH terbuka untuk semua alamat yang bisa menjangkau server.
SSH_RESTRICTED=true
# Installer menolak mengunci SSH jika ada sesi SSH aktif dari alamat di luar ALLOWED_SUBNETS.
# Set true hanya jika Anda punya akses console fisik atau dari provider.
ALLOW_OUTSIDE_SSH_SESSION=false
# Installer mengecek dulu apakah semua sumber unduhan bisa dijangkau. Set true untuk melewati.
SKIP_NETWORK_CHECK=false
# auto = otomatis memakai versi Docker yang aman untuk container LXC Proxmox. true/false untuk memaksa.
DOCKER_LXC_PIN=auto

# ---------- Tim (opsional) ----------
# Kosongkan untuk satu pengguna. Untuk tim, isi nama:public_key per anggota, dipisah tanda |
# Contoh: TEAM_MEMBERS="andi:ssh-ed25519 AAAA... andi@laptop|budi:ssh-ed25519 AAAA... budi@laptop"
# Setiap anggota mendapat user Linux sendiri (tanpa sudo), konfigurasi OMP sendiri,
# dan rentang port sendiri (pengguna utama 8100-8199, anggota berikutnya 8200-8299, dst).
TEAM_MEMBERS=""
# true = anggota tim boleh memakai Docker (setara akses root ke server). false = hanya pengguna utama.
TEAM_DOCKER_ACCESS=true

# ---------- Git ----------
GIT_NAME=""
GIT_EMAIL=""

# ---------- Toolchain ----------
# Versi PHP, dipisahkan spasi. Versi pertama menjadi default.
PHP_VERSIONS="8.3 7.4"
INSTALL_PLAYWRIGHT=true
ENABLE_SEARXNG=true

# ---------- Rahasia untuk OMP (boleh dikosongkan dulu, isi nanti) ----------
# Key dari dashboard 9Router (API Keys), buat satu khusus untuk server ini.
NINEROUTER_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
CONTEXT7_API_KEY=

# ---------- Opsional ----------
# Repo omp-config pribadi Anda (git URL). Kosong = pakai bawaan devstack.
OMP_CONFIG_REPO=

# Sinkron config bawaan devstack ke ~/omp-config semua user saat install atau update (sebagai commit git).
# Isi false jika config agent Anda dikelola sendiri dan tidak ingin diperbarui otomatis.
DEVSTACK_SYNC_CONFIG=true
